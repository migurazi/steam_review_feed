# Steam Web API Key (필수)
# https://steamcommunity.com/dev/apikey 에서 발급
STEAM_API_KEY=

# 세션 암호화 키 (필수, 32자 이상)
# 생성 예시: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# IsThereAnyDeal API Key (선택, 번들 차트 메이커 기능)
# https://isthereanydeal.com/apps/my/ 에서 발급
ITAD_API_KEY=

# 서비스 기본 URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000
